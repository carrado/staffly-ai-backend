NODE_ENV=development
PORT=7100

# Production only — initializers/keepAlive.js self-pings BASE_URL/health every
# 10 min to stay ahead of the ~15-min free-tier idle cutoff. Skipped entirely
# unless NODE_ENV=production and this is a public (non-localhost) URL.
BASE_URL=

# Same cluster as velte-backend — this service reads its Product/Store/User/
# Wallet collections directly and writes its own (VendorExposure,
# RecruitmentLead, Notification, PushSubscription share the collection with
# velte-backend's own reads/writes there).
MONGODB_URI=
MONGODB_URI_PRODUCTION=

VOYAGE_API_KEY=
GOOGLE_PLACES_API_KEY=

# Same VAPID keypair as velte-backend — this service's expired-listing
# notify delivers push through the same subscriptions velte-backend's own
# notifyUser calls use.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for /api/internal/* (service-to-service only). MUST equal
# velte-backend's own INTERNAL_SERVICE_SECRET — its matchingClient.service.js
# sends it as x-internal-secret. Unset, every internal call 503s.
INTERNAL_SERVICE_SECRET=

# MUST equal velte-backend's MIN_LEAD_COST_KOBO (src/utils/leadPricing.js)
# exactly — see retrieval.service.js's filterWalletEligible. One flat rate for
# every vendor since 2026-09-03: 100000 (₦1,000).
LEAD_COST_KOBO=100000
